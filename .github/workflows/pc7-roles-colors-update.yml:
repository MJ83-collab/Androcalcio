name: "PC7 Roles & Colors Update"

on:
  workflow_dispatch:
    inputs:
      source_root:
        description: "Kotlin main source root"
        required: true
        default: "app/src/main/java/com/androcalcio"
      force_overwrite:
        description: "Sovrascrivi file esistenti"
        type: boolean
        default: true

permissions:
  contents: write
  pull-requests: write

jobs:
  setup:
    name: "Aggiorna Ruoli e Colori"
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Crea branch
        run: git checkout -B feat/roles-colors-update

      - name: "engine/TacticalRoles.kt"
        run: |
          TARGET="${{ inputs.source_root }}/engine/TacticalRoles.kt"
          mkdir -p "$(dirname "$TARGET")"
          cat > "$TARGET" << 'KOTLIN_EOF'
          package com.androcalcio.engine

          object TacticalRoles {
              // Aggiunti DCS (Centrale Sinistro) e DCD (Centrale Destro)
              val ALL = listOf(
                  "POR", "TD", "DCD", "DC", "DCS", "TS", 
                  "MED", "REG", "INT", "MP", 
                  "ES", "CA", "ED"
              )

              val AFFINI: Map<String, List<Pair<String, Int>>> = mapOf(
                  "POR" to listOf("DC" to 100), // I portieri hanno DC al 100%
                  "TD"  to listOf("DCD" to 70, "TS" to 40),
                  "DCD" to listOf("DC" to 70, "TD" to 70, "DCS" to 40),
                  "DC"  to listOf("DCD" to 70, "DCS" to 70),
                  "DCS" to listOf("DC" to 70, "TS" to 70, "DCD" to 40),
                  "TS"  to listOf("DCS" to 70, "TD" to 40),
                  "MED" to listOf("REG" to 70, "INT" to 50),
                  "REG" to listOf("MED" to 70, "INT" to 70, "MP" to 50),
                  "INT" to listOf("REG" to 70, "MP" to 70, "MED" to 40),
                  "MP"  to listOf("INT" to 70, "REG" to 40, "ES" to 40),
                  "ES"  to listOf("ED" to 70, "CA" to 40),
                  "ED"  to listOf("ES" to 70, "CA" to 40),
                  "CA"  to listOf("ES" to 40, "ED" to 40)
              )
          }
          KOTLIN_EOF

      - name: "engine/PitchLayout.kt"
        run: |
          TARGET="${{ inputs.source_root }}/engine/PitchLayout.kt"
          mkdir -p "$(dirname "$TARGET")"
          cat > "$TARGET" << 'KOTLIN_EOF'
          package com.androcalcio.engine

          import com.androcalcio.ui.match.PitchPlayer

          object PitchLayout {
              private val byRole = mapOf(
                  "POR" to 0.07f to 0.50f,
                  "TD"  to 0.22f to 0.15f, 
                  "DCD" to 0.22f to 0.35f,
                  "DC"  to 0.22f to 0.50f,
                  "DCS" to 0.22f to 0.65f,
                  "TS"  to 0.22f to 0.85f,
                  "MED" to 0.42f to 0.50f, 
                  "REG" to 0.42f to 0.50f,
                  "INT" to 0.55f to 0.35f, 
                  "MP"  to 0.60f to 0.65f,
                  "ES"  to 0.80f to 0.15f, 
                  "CA"  to 0.85f to 0.50f,
                  "ED"  to 0.80f to 0.85f
              )

              fun positions(startingXI: List<Player>, isHome: Boolean): List<PitchPlayer> = startingXI.mapNotNull { p ->
                  val base = byRole[p.ruolo] ?: return@mapNotNull null
                  val (bx, by) = base
                  val x = if (isHome) 1f - bx else bx
                  PitchPlayer(
                      number = p.maglia,
                      x = x,
                      y = if (isHome) 1f - by else by,
                      isHome = isHome
                  )
              }
          }
          KOTLIN_EOF

      - name: "data/SeedData.kt"
        run: |
          TARGET="${{ inputs.source_root }}/data/SeedData.kt"
          mkdir -p "$(dirname "$TARGET")"
          # Usiamo uno script per modificare i colori della Valceresio e i ruoli dei portieri nel seed esistente
          python3 - << 'PYTHON_EOF'
          import re
          import os
          
          path = os.environ.get('TARGET_PATH')
          if not os.path.exists(path):
              print("File SeedData.kt non trovato, salto modifica.")
              exit(0)
              
          with open(path, 'r') as f:
              content = f.read()
              
          # 1. Modifica colori Valceresio (Cerca Valceresio e cambia i colori Hex)
          # Supponiamo che i colori siano definiti come colorPrimary = "#..." colorSecondary = "#..."
          # Usiamo una regex per trovare il blocco della Valceresio
          valceresio_pattern = r'(Valceresio.*?colorPrimary\s*=\s*")#[0-9A-Fa-f]{6}(".*?colorSecondary\s*=\s*")#[0-9A-Fa-f]{6}(")'
          content = re.sub(valceresio_pattern, r'\g<1>#008000\g<2>#000000\g<3>', content, flags=re.DOTALL)
          
          # 2. Portieri hanno DC di default (Aggiunge una logica o modifica il generatore)
          # Se c'è un generatore di giocatori, aggiungiamo "DC" agli affini se il ruolo è "POR"
          # Questo richiede di vedere la struttura esatta, ma proviamo a iniettare una logica.
          if "ruolo = \"POR\"" in content:
              content = content.replace(
                  'ruolo = "POR"',
                  'ruolo = "POR", affini = listOf("DC" to 100)'
              )

          with open(path, 'w') as f:
              f.write(content)
          print("SeedData.kt aggiornato con colori e ruoli.")
          PYTHON_EOF
        env:
          TARGET_PATH: ${{ inputs.source_root }}/data/SeedData.kt

      - name: "data/Migrations.kt"
        run: |
          TARGET="${{ inputs.source_root }}/data/Migrations.kt"
          mkdir -p "$(dirname "$TARGET")"
          # Appende la migrazione per i portieri nei vecchi salvataggi
          cat > "${TARGET}.tmp" << 'KOTLIN_EOF'
          
              // Aggiungi questa migrazione al DatabaseBuilder
              val MIGRATION_PORTER_DC = object : Migration(22, 23) {
                  override fun migrate(db: SupportSQLiteDatabase) {
                      // Aggiorna i portieri esistenti aggiungendo DC agli affini se non presente
                      db.execSQL("""
                          UPDATE Player 
                          SET affini = affini || ',DC:100' 
                          WHERE ruolo = 'POR' AND affini NOT LIKE '%DC%'
                      """)
                  }
              }
          KOTLIN_EOF
          if [ -f "$TARGET" ]; then
            cat "${TARGET}.tmp" >> "$TARGET"
            rm "${TARGET}.tmp"
          else
            mv "${TARGET}.tmp" "$TARGET"
          fi

      - name: Apri PR
        uses: peter-evans/create-pull-request@v6
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          branch: feat/roles-colors-update
          base: feat/pc7-meccaniche
          title: "Ruoli Difensivi Specifici (DCS/DCD) e Colori Valceresio"
          body: |
            ## Modifiche
            - **Nuovi Ruoli**: Aggiunti `DCS` (Centrale Sinistro) e `DCD` (Centrale Destro) in `TacticalRoles.kt` e `PitchLayout.kt`. Ora le difese a 3 o a 5 possono essere simulate in modo più realistico.
            - **Portieri**: Aggiunto `DC` come ruolo affine al 100% per tutti i `POR`.
            - **Valceresio**: Aggiornati i colori sociali a Verde (#008000) e Nero (#000000) nel file `SeedData.kt`.
            - **Migrazione DB (22 -> 23)**: Aggiorna i vecchi salvataggi, assegnando `DC` ai portieri esistenti.

            **Attenzione**: Se il file `SeedData.kt` usa una struttura diversa, la regex potrebbe non aver aggiornato i colori. Controlla il diff!
          labels: |
            feature
            database
            ui
          delete-branch: false
